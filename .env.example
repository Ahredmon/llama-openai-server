# llama-openai-server environment configuration
# Copy this file to .env and adjust for your setup.

# ── Model ──────────────────────────────────────────────────────────────────
MODEL_ID=local-model
# Explicit path to a local GGUF file (overrides HF auto-download)
MODEL_PATH=models/my-model.Q4_K_M.gguf
# Or let the server download from HuggingFace:
# HF_REPO_ID=TheBloke/Mistral-7B-Instruct-v0.2-GGUF
# HF_MODEL_FILENAME=mistral-7b-instruct-v0.2.Q4_K_M.gguf

# ── llama.cpp / ROCm ───────────────────────────────────────────────────────
N_GPU_LAYERS=80
N_CTX=0          # 0 = auto-detect from VRAM
N_THREADS=8
N_BATCH=1024
N_UBATCH=512
MLOCK=true
OFFLOAD_KQV=true
FLASH_ATTN=false  # set true only if your ROCm build supports it
F16_KV=true

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Safety ─────────────────────────────────────────────────────────────────
ROCM_REQUIRED=true
# ALLOW_MOCK_BACKEND=false
